# ---- x402 seller (the payment path needs NO private key) -----------------
PAY_TO=0.0.0000000
FACILITATOR_URL=https://api.testnet.blocky402.com
AMOUNT_TINYBAR=100000
PORT=4021
# Public base URL this service is reachable at; used for the ERC-8004
# registration file and the `endpoint` recorded in buyer feedback.
PUBLIC_BASE_URL=http://localhost:4021

# ---- EIP-712 attestation signing ----------------------------------------
# secp256k1. Its address is published in the registration file and is what
# verify-charge recovers signatures against.
ATTESTOR_PRIVATE_KEY=0x

# ---- HCS anchoring (optional; anchoring is skipped when absent) ----------
HEDERA_ACCOUNT_ID=0.0.0000000
# ECDSA secp256k1 ONLY. ED25519 keys fail silently in EVM-adjacent tooling.
HEDERA_PRIVATE_KEY=0x
# Topic must be created with a submitKey and NO adminKey: see `npm run topic`.
HCS_TOPIC_ID=0.0.0000000

# ---- buyer (the consuming agent) ----------------------------------------
BUYER_ACCOUNT_ID=0.0.0000000
BUYER_PRIVATE_KEY=0x
ATTESTOR_URL=http://localhost:4021
# Atomic per-payment ceiling for the buyer's x402 spend controls. Native HBAR is
# not a default asset, so it must be allowlisted with a cap.
BUYER_MAX_TINYBAR=1000000
# Set to skip the on-chain ERC-8004 feedback leg of the buyer run.
BUYER_SKIP_FEEDBACK=
# ERC-8004 agent id minted by IdentityRegistry.register(); required to leave
# feedback. Empty means the buyer reports the receipt and skips the call.
ATTESTOR_AGENT_ID=
