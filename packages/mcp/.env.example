# The Graph Market JWT (https://thegraph.market). Required for live data.
SUBSTREAMS_API_TOKEN=
# Alternatively: path to a dotenv file outside the repo that holds SUBSTREAMS_API_TOKEN.
SUBSTREAMS_ENV_FILE=

# Which networks get a long-lived stream. The token allows 2 concurrent streams, shared with range requests.
FEED_NETWORKS=base
STREAM_SLOTS=2
STREAM_SLOT_WAIT_MS=3000

# Package and module. The default is the sibling Substreams package's v0.2.0 spkg and its map_positions module.
SUBSTREAMS_PACKAGE=
SUBSTREAMS_MODULE=map_positions
NOTES_FILE=

# Freshness. MAX_STALENESS_SECONDS defaults to the attestor policy (900).
MAX_STALENESS_SECONDS=
BASE_FINAL_BLOCKS_ONLY=true
# Optional map_positions cadence in blocks, replacing the package default (Base 150, mainnet 50).
# A tick only fires in a block that carries an ERC-4626 event, because Substreams skips the module
# otherwise. 1 reads on every block that executes, which keeps position age near finality lag.
BASE_POSITIONS_EVERY=1
MAINNET_POSITIONS_EVERY=
MAINNET_FINAL_BLOCKS_ONLY=false
BASE_HEAD_MAX_LAG_SECONDS=
MAINNET_HEAD_MAX_LAG_SECONDS=

# Series older than the live buffer are fetched by a bounded range request.
RANGE_MAX_BLOCKS=5000
RANGE_TIMEOUT_MS=120000
SERIES_BUFFER_POINTS=2000
START_BLOCKS_BACK=300

# Where the paid, signed x402 attestation lives (packages/attestor).
ATTESTOR_URL=http://localhost:4021
# Optional: the attestor's dist/src directory, if it is not at ../attestor/dist/src.
ATTESTOR_DIST=

PORT=4030
PUBLIC_BASE_URL=
