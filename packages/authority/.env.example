# Defaults target the Speculos emulator brought up as described in README.md.
# Nothing here is a secret; the emulator seed is public and so is the address it derives.

# Speculos HTTP API, or a device bridge for real hardware.
PLIMSOLL_LEDGER_URL=http://127.0.0.1:5000

PLIMSOLL_LEDGER_PATH=44'/60'/0'/0/0

# The only key allowed to authorise a halt, a resume or a change to the load line.
# This default is the address the published Speculos test mnemonic derives at the path above.
# Point it at a real device before this authority guards anything real.
PLIMSOLL_LEDGER_ADDRESS=0xDad77910DbDFdE764fC21FCD4E74D71bBACA6D8D

# nanos | nanosp | nanox | stax | flex
PLIMSOLL_LEDGER_MODEL=nanosp

PLIMSOLL_LEDGER_CONNECT_TIMEOUT_MS=20000

# How long a human gets to decide before the device action is cancelled.
PLIMSOLL_LEDGER_SIGN_TIMEOUT_MS=120000

# Container the test harness restarts when a cancelled review leaves the emulator wedged.
PLIMSOLL_SPECULOS_CONTAINER=spec
