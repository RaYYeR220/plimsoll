{
  "name": "@plimsoll/authority",
  "version": "0.1.0",
  "private": true,
  "description": "Hardware-approved authority for Plimsoll: HALT/RESUME and load-line changes require a physical approval on a Ledger device.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "contracts",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:unit": "npm run build && node --test \"dist/test/mandate.test.js\" \"dist/test/tamper.test.js\"",
    "test:device": "npm run build && node --test \"dist/test/device.test.js\"",
    "test:sol": "forge test -vv",
    "test:all": "npm run test && npm run test:sol",
    "demo": "npm run build && node dist/demo/run.js"
  },
  "dependencies": {
    "@ledgerhq/context-module": "2.5.0",
    "@ledgerhq/device-management-kit": "1.9.0",
    "@ledgerhq/device-signer-kit-ethereum": "1.18.0",
    "@ledgerhq/device-transport-kit-speculos": "1.2.1",
    "ethers": "^6.17.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
